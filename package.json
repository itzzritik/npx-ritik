{
	"name": "ritik",
	"version": "1.0.14",
	"description": "CLI Portfolio",
	"keywords": [
		"ritik",
		"nodejs",
		"javascript",
		"shell",
		"cli",
		"console",
		"open-source",
		"npm",
		"portfolio",
		"typescript",
		"terminal",
		"command-line",
		"tui",
		"dev",
		"developer",
		"npx"
	],
	"homepage": "https://github.com/itzzritik/npx-ritik#readme",
	"bugs": {
		"url": "https://github.com/itzzritik/npx-ritik/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itzzritik/npx-ritik.git"
	},
	"license": "ISC",
	"author": {
		"name": "Ritik Srivastava"
	},
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"ritik": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun build src/index.ts --target=node --minify --banner=\"#!/usr/bin/env node\" --outfile=dist/index.js --external=figlet",
		"check": "ultracite check",
		"clean": "rm -rf node_modules bun.lock dist && bun install",
		"demo": "bun run build && vhs demo/demo.tape",
		"fix": "ultracite fix",
		"start": "bun run build && node dist/index.js"
	},
	"dependencies": {
		"figlet": "^1.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"boxen": "^9.0.0",
		"chalk": "^6.0.1",
		"typescript": "^7.0.2",
		"ultracite": "^8.1.1"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
