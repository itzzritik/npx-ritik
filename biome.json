{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["!node_modules", "!dist", "!build"]
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 170,
		"formatWithErrors": true,
		"bracketSpacing": true,
		"bracketSameLine": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": "off",
				"noImplicitAnyLet": "off",
				"noExplicitAny": "off"
			},
			"style": {
				"noMagicNumbers": "off",
				"useBlockStatements": "off",
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noForEach": "off"
			},
			"performance": {
				"noBarrelFile": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"extends": ["ultracite/biome/core"]
}
